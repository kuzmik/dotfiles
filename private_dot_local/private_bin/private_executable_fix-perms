#!/bin/bash
# ~/.local/bin/fix-perms
#
# Lock down ownership and permissions of a directory tree.
# Usage: fix-perms [DIR]   (defaults to $HOME)
#
# Each step is best-effort: files we can't touch (e.g. TCC/SIP-protected paths
# under ~/Library on macOS) are skipped quietly rather than aborting the run.
set -Eeuo pipefail

target="${1:-$HOME}"

if [[ ! -d "$target" ]]; then
  echo "fix-perms: '$target' is not a directory" >&2
  exit 1
fi

# fix the owner and group for the target tree
chown -R "$(id -un)":"$(id -gn)" "$target" 2>/dev/null || true

# make all directories 700
find "$target" -type d -exec chmod 700 {} + 2>/dev/null || true

# set any executable files to 700
# BSD only: find "$target" -type f -perm +111 ! -perm 700 -exec chmod 700 {} +
find "$target" -type f \( -perm -u+x -o -perm -g+x -o -perm -o+x \) ! -perm 700 -exec chmod 700 {} + 2>/dev/null || true

# find any file that is readable by anyone, but is not 600. correct that
# BSD only: find "$target" -type f -perm +400 ! \( -perm 600 -o -perm 700 \) -exec chmod 600 {} +
find "$target" -type f -perm -u+r ! \( -perm 600 -o -perm 700 \) -exec chmod 600 {} + 2>/dev/null || true
