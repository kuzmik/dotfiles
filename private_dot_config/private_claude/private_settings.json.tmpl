{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  {{- if .workMode }}
  "env": {
    "CLAUDE_ENV_FILE": "/usr/local/persona/npq-wrapper.sh"
  },
  {{- end }}
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "hooks": {
    {{- if lookPath "atuin" }}
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    {{- end }}
    {{ if lookPath "herdr" }}
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/nick/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
    {{- end }}
  },
  "statusLine": {
    "type": "command",
    "command": "starship statusline claude-code"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    {{- if .workMode }}
    "watch-pr@persona-claude-marketplace": true,
    {{- end }}
    "superpowers@claude-plugins-official": true
  },
  "disableDeepLinkRegistration": "disable",
  "extraKnownMarketplaces": {},
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "verbose": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754530246324
  },
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen"
}
